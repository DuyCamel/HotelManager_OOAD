{
  "name": "hotelmanager-ooad-web",
  "version": "2.0.0",
  "private": true,
  "description": "HotelManager web · Express, EJS, JavaScript và SQL Server",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "node scripts/setup-env.js",
    "setup": "node scripts/setup-env.js",
    "start": "node src/server.js",
    "dev": "node scripts/dev.js",
    "dev:sepay": "node scripts/dev.js",
    "test": "node --test --test-concurrency=1",
    "check:syntax": "node scripts/check-syntax.js",
    "check": "npm run check:syntax && npm run test && npm run docs:check",
    "db:check": "node scripts/check-db.js",
    "docs:dictionary": "node scripts/generate-dictionary.js",
    "docs:check": "node scripts/generate-dictionary.js --check"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mssql": "^12.7.11",
    "multer": "^2.5.0"
  }
}
