<!-- Chứng từ đã chốt: chỉ hiển thị và in/lưu PDF, không có thao tác sửa. -->
<%- include('../partials/head') %>
<%
  const safeHotel = hotel || {};
  const safeCustomer = customer || {};
  const safeLines = Array.isArray(lines) ? lines : [];
  const grossTotal = Number(invoice.roomCharge || 0) + Number(invoice.serviceCharge || 0) + Number(invoice.surcharge || 0);
  const total = grossTotal - Number(invoice.discount || 0);
  const due = invoice.amountDue !== null && invoice.amountDue !== undefined && invoice.amountDue !== '' && Number.isFinite(Number(invoice.amountDue)) ? Number(invoice.amountDue) : total - Number(invoice.deposit || 0);
  const statusLabels = { PAID: 'Đã thanh toán', DRAFT: 'Nháp' };
  const methodLabels = { CASH: 'Tiền mặt', TRANSFER: 'Chuyển khoản', BANK: 'Chuyển khoản', CARD: 'Thẻ' };
%>
<body class="invoice-page">
<main class="paper" aria-labelledby="invoice-title">
<a class="brand" href="/app/invoices">A<span>✦</span> AURORA</a>
<h1 id="invoice-title">Hóa đơn lưu trú</h1>
<p><%= safeHotel.hotelName || 'Khách sạn' %> · <%= safeHotel.address || 'Địa chỉ chưa cập nhật' %> · <%= safeHotel.hotline || 'Hotline chưa cập nhật' %></p>
<p class="muted">Bản chứng từ chỉ đọc. Dữ liệu phản ánh hóa đơn đã lưu trong hệ thống.</p>
<hr>
<div class="split">
<div>
<small>KHÁCH HÀNG</small>
<h3><%= safeCustomer.name || 'Chưa có dữ liệu khách hàng' %></h3>
<p><%= safeCustomer.phone || 'Chưa có số điện thoại' %></p>
<p>CCCD / Hộ chiếu: <%= safeCustomer.identityNo || 'Chưa có dữ liệu' %></p>
</div>
<div>
<strong><%= invoice.id %></strong>
<%
  const formatInvoiceDate = (val) => {
    if (!val) return 'Chưa có thời điểm phát hành';
    const d = new Date(val);
    if (isNaN(d.getTime())) return val;
    try {
      const parts = new Intl.DateTimeFormat('en-GB', {
        timeZone: 'Asia/Ho_Chi_Minh',
        day: '2-digit', month: '2-digit', year: 'numeric',
        hour: '2-digit', minute: '2-digit', hour12: false
      }).formatToParts(d);
      const p = Object.fromEntries(parts.map(i => [i.type, i.value]));
      return `${p.hour}:${p.minute} ${p.day}/${p.month}/${p.year}`;
    } catch {
      return d.toLocaleString('vi-VN');
    }
  };
%>
<p><%= formatInvoiceDate(invoice.issuedAt) %></p>
<p>Phiếu thuê: <%= invoice.stayId || '—' %></p>
<p>Phòng: <%= invoice.roomName || '—' %></p>
<p>Phương thức: <%= methodLabels[invoice.method] || invoice.method || 'Chưa có dữ liệu' %></p>
<% if (invoice.paymentReference) { %><p>Mã giao dịch: <%= invoice.paymentReference %></p><% } %>
<span class="badge <%= invoice.status || 'DRAFT' %>"><%= statusLabels[invoice.status] || invoice.status || 'Chưa có trạng thái' %></span>
</div>
</div>
<div class="table-scroll">
<table>
<caption class="muted">Chi tiết các khoản đã chốt</caption>
<thead>
<tr><th>Nội dung</th><th>Số lượng</th><th>Đơn giá</th><th>Thành tiền</th></tr>
</thead>
<tbody>
<% safeLines.forEach(line => { const amount = line.lineAmount !== null && line.lineAmount !== undefined && line.lineAmount !== '' && Number.isFinite(Number(line.lineAmount)) ? Number(line.lineAmount) : Number(line.quantity || 0) * Number(line.unitPrice || 0); %>
<tr>
<td><%= line.description || line.lineType || 'Dòng hóa đơn' %></td>
<td><%= Number(line.quantity || 0).toLocaleString('vi-VN') %></td>
<td><%= Number(line.unitPrice || 0).toLocaleString('vi-VN') %> ₫</td>
<td><%= amount.toLocaleString('vi-VN') %> ₫</td>
</tr>
<% }) %>
<% if (!safeLines.length) { %>
<tr><td colspan="4" class="empty">Không có dữ liệu dòng hóa đơn.</td></tr>
<% } %>
</tbody>
</table>
</div>
<div class="invoice-totals">
<p>Tổng cộng <strong><%= grossTotal.toLocaleString('vi-VN') %> ₫</strong></p>
<% if (Number(invoice.discount || 0)) { %>
<p>Giảm giá <strong>− <%= Number(invoice.discount).toLocaleString('vi-VN') %> ₫</strong></p>
<p>Sau giảm giá <strong><%= total.toLocaleString('vi-VN') %> ₫</strong></p>
<% } %>
<p>Đã đặt cọc <strong>− <%= Number(invoice.deposit || 0).toLocaleString('vi-VN') %> ₫</strong></p>
<h3>Thanh toán còn lại <span><%= due.toLocaleString('vi-VN') %> ₫</span></h3>
</div>
<p class="muted">Cảm ơn bạn đã lựa chọn Aurora. Hẹn gặp lại!</p>
<button id="print" type="button" class="primary">In / Lưu PDF</button>
</main>
</body>
</html>
