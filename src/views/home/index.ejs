<%- include('../partials/head') %>
<body
  class="public-page"
  data-experience-target="<%= experienceHref %>"
  data-customer="<%= viewer?.isCustomer ? 'true' : 'false' %>"
>
  <a class="skip-link" href="#main-content">Chuyển đến nội dung chính</a>

  <header class="public-nav">
    <a class="brand" href="/" aria-label="Aurora Hotel, trang chủ">
      A<span aria-hidden="true">✦</span> AURORA
    </a>
    <nav aria-label="Điều hướng chính">
      <a href="#stay">Kỳ nghỉ</a>
      <a href="#contact">Liên hệ</a>
    </nav>
    <div class="nav-account">
      <% if (viewer) { %>
        <span class="login-state">
          <i aria-hidden="true"></i>
          Xin chào, <strong><%= viewer.name %></strong>
        </span>
      <% } %>
      <a class="outline" href="<%= experienceHref %>"><%= experienceLabel %></a>
    </div>
  </header>

  <main id="main-content">
    <section
      class="cinematic"
      aria-roledescription="carousel"
      aria-label="Câu chuyện Aurora"
      data-carousel
    >
      <div class="cinematic-viewport" id="aurora-carousel">
        <div class="cinematic-track is-at-0" data-carousel-track>
          <a
            class="cinematic-slide scene-arrival"
            href="<%= experienceHref %>"
            data-carousel-slide
            aria-label="Khám phá kỳ nghỉ tại Aurora"
          >
            <span class="slide-shade" aria-hidden="true"></span>
            <span class="slide-copy">
              <span class="slide-number">01 / 03</span>
              <span class="eyebrow">A BRIGHTER WAY TO STAY</span>
              <h1>Thành phố ngoài cửa.<br><em>Bình yên ở bên trong.</em></h1>
              <span class="slide-description">
                Ánh sáng, khoảng thở và sự chăm sóc vừa đủ cho những ngày bạn
                muốn sống chậm hơn.
              </span>
              <span class="slide-cta">
                <%= viewer?.isCustomer ? 'Chọn căn phòng của bạn' : viewer ? 'Mở không gian Aurora' : 'Đăng nhập để đặt kỳ nghỉ' %>
              </span>
            </span>
          </a>

          <a
            class="cinematic-slide scene-suite"
            href="<%= experienceHref %>"
            data-carousel-slide
            aria-label="Khám phá những căn phòng đầy ánh sáng"
            aria-hidden="true"
            tabindex="-1"
          >
            <span class="slide-shade" aria-hidden="true"></span>
            <span class="slide-copy slide-copy-right">
              <span class="slide-number">02 / 03</span>
              <span class="eyebrow">ROOM TO EXHALE</span>
              <h2>Buổi sáng dịu dàng.<br><em>Đêm thật sâu.</em></h2>
              <span class="slide-description">
                Chất liệu tự nhiên, ga giường mát và những ô cửa đón trọn nắng
                sớm.
              </span>
              <span class="slide-cta">
                Xem phòng trống
              </span>
            </span>
          </a>

          <a
            class="cinematic-slide scene-pool"
            href="<%= experienceHref %>"
            data-carousel-slide
            aria-label="Khám phá nhịp sống thư thái tại Aurora"
            aria-hidden="true"
            tabindex="-1"
          >
            <span class="slide-shade" aria-hidden="true"></span>
            <span class="slide-copy">
              <span class="slide-number">03 / 03</span>
              <span class="eyebrow">YOUR CITY, SOFTENED</span>
              <h2>Chạm vào nắng.<br><em>Trôi qua chiều.</em></h2>
              <span class="slide-description">
                Một hồ bơi trên cao, bữa sáng thảnh thơi và thành phố lấp lánh
                phía xa.
              </span>
              <span class="slide-cta">
                Bắt đầu hành trình
              </span>
            </span>
          </a>
        </div>
      </div>

      <div class="carousel-controls">
        <button
          type="button"
          class="carousel-arrow"
          data-carousel-prev
          aria-controls="aurora-carousel"
          aria-label="Banner trước"
        >
          ←
        </button>
        <div class="carousel-dots" aria-label="Chọn banner">
          <button type="button" class="is-active" data-carousel-dot="0" aria-label="Banner 1" aria-current="true"></button>
          <button type="button" data-carousel-dot="1" aria-label="Banner 2"></button>
          <button type="button" data-carousel-dot="2" aria-label="Banner 3"></button>
        </div>
        <button
          type="button"
          class="carousel-arrow"
          data-carousel-next
          aria-controls="aurora-carousel"
          aria-label="Banner tiếp theo"
        >
          →
        </button>
      </div>
      <p class="sr-only" aria-live="polite" data-carousel-status>Banner 1 trên 3</p>
      <span class="carousel-progress" aria-hidden="true"><i></i></span>
    </section>

    <section class="reservation-wrap" id="stay" aria-labelledby="reservation-title">
      <div class="reservation-intro">
        <span class="eyebrow">PLAN YOUR ARRIVAL</span>
        <h2 id="reservation-title">Kỳ nghỉ của bạn bắt đầu ở đây.</h2>
      </div>
      <form id="home-reservation" class="reservation-form" action="<%= experienceHref %>" method="get">
        <label>
          Ngày nhận phòng
          <input name="startAt" type="date" lang="vi-VN" required>
        </label>
        <label>
          Ngày trả phòng
          <input name="endAt" type="date" lang="vi-VN" required>
        </label>
        <label>
          Số khách
          <select name="guests" required>
            <option value="1">1 khách</option>
            <option value="2" selected>2 khách</option>
            <option value="3">3 khách</option>
            <option value="4">4 khách</option>
            <option value="5">5 khách</option>
            <option value="6">6 khách</option>
          </select>
        </label>
        <button class="primary" type="submit">
          Kiểm tra phòng
        </button>
        <p class="form-message" role="status" aria-live="polite"></p>
      </form>
    </section>

    <section class="contact-section" id="contact" aria-labelledby="contact-title">
      <div class="contact-lead">
        <span class="eyebrow">COME FIND YOUR LIGHT</span>
        <h2 id="contact-title">Hẹn gặp bạn<br>tại Aurora.</h2>
      </div>
      <div class="contact-details">
        <div>
          <span class="contact-label">ĐỊA CHỈ</span>
          <strong><%= data.hotel.hotelName %></strong>
          <p><%= data.hotel.address %></p>
        </div>
        <div>
          <span class="contact-label">LIÊN HỆ</span>
          <a href="<%= data.phoneHref %>"><%= data.hotel.hotline %></a>
          <p>Đón khách từ <%= data.hotel.checkInTime %> · Trả phòng trước <%= data.hotel.checkOutTime %></p>
        </div>
      </div>
    </section>
  </main>

  <footer class="public-footer">
    <a class="brand" href="/" aria-label="Aurora Hotel, trang chủ">
      A<span aria-hidden="true">✦</span> AURORA
    </a>
    <p>Light-filled stays · Thoughtful hospitality</p>
    <small>
      © 2026 Aurora Hotel
      <% if (config.mode === 'demo') { %> · Trải nghiệm với dữ liệu demo cục bộ<% } %>
    </small>
  </footer>

  <script type="module" src="/assets/js/modules/bookings/search.js"></script>
</body>
</html>
