# Copy thành .env hoặc chạy npm install / npm run setup để tạo tự động.
NODE_ENV=development
PORT=3000
APP_NAME=Aurora Hotel
APP_TIME_ZONE=Asia/Ho_Chi_Minh
# Thời gian nghiệp vụ để dễ thử nghiệm; dùng HH:mm hoặc HH:mm:ss.
APP_CHECK_IN_TIME=14:00:00
APP_CHECK_OUT_TIME=12:00:00
APP_NO_SHOW_TIME=22:00:00
APP_BOOKING_HOLD_MINUTES=10
# demo: dữ liệu giả lưu JSON; sqlserver: kết nối SQL thật, không tự seed/drop DB.
DB_MODE=demo
DEMO_DATA_FILE=./data/demo.json
# npm run setup sinh secret ngẫu nhiên khi tạo .env. Không dùng placeholder này khi chạy.
SESSION_SECRET=CHANGE_ME_GENERATE_WITH_NPM_RUN_SETUP
# Giới hạn thời gian phiên cho khách hàng (giờ); toàn bộ nhân viên duy trì phiên dài hạn.
SESSION_HOURS=8
# OTP demo chỉ dùng local. Khi production phải thay nhà cung cấp SMS thật.
OTP_PROVIDER=demo
# Mã OTP cố định để kiểm thử (nếu đặt thì hệ thống dùng mã này thay vì sinh ngẫu nhiên)
OTPNUM=9999
# SQL Server: chạy toàn bộ database/HotelManagerOOAD.sql bằng SSMS/sqlcmd.
DB_SERVER=localhost
DB_PORT=1433
# Tên tùy chọn; phải trùng database đã chọn khi chạy script SQL.
DB_NAME=HotelManagerOOAD
DB_USER=hotel_dev
DB_PASSWORD=CHANGE_ME
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
# Thư mục trên MÁY CHỦ SQL Server, không phải đường dẫn trình duyệt.
SQL_BACKUP_DIR=
# Mặc định dùng SQL Authentication qua tedious; không cần JDBC hoặc DLL Java.
TRUST_PROXY=0
# SePay: key chi o server; webhook JSON POST /api/webhooks/sepay, Authorization: Apikey <key>.
# Dien thong tin tai khoan nhan tien da lien ket voi SePay trong .env local.
SEPAY_WEBHOOK_API_KEY=
SEPAY_BANK_ID=
SEPAY_ACCOUNT_NO=
SEPAY_ACCOUNT_NAME=
